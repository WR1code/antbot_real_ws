<?xml version="1.0"?>
<package format="3">
  <name>antbot_mid360_fusion</name>
  <version>0.1.0</version>
  <description>Field-preserving dual Livox MID360 crop, TF, merge, and benchmark node.</description>
  <maintainer email="w@example.com">w</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>antbot_dual_lidar</exec_depend>
  <exec_depend>antbot_mapping</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
