<?xml version="1.0"?>
<robot name="antbot_payload_tower" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Match the colors authored by isaac/config/rgbd_camera.yaml and the
       Piper-X source URDF used to generate the Isaac USD. -->
  <material name="payload_steel">
    <color rgba="0.18 0.20 0.22 1.0"/>
  </material>
  <material name="payload_camera_dark">
    <color rgba="0.08 0.10 0.12 1.0"/>
  </material>
  <material name="piper_gray">
    <color rgba="0.59216 0.61961 0.65098 1.0"/>
  </material>
  <material name="piper_light_gray">
    <color rgba="0.69804 0.69804 0.69804 1.0"/>
  </material>
  <material name="piper_white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="piper_finger_blue">
    <color rgba="0.79216 0.81961 0.93333 1.0"/>
  </material>

  <xacro:property name="piper_mesh_dir"
                  value="file:///home/w/project/sources/piper_isaac_sim/piper_x_description/meshes/dae"/>

  <xacro:macro name="PiperMeshLink"
               params="link_name mesh_name material_name xyz:='0 0 0' rpy:='0 0 0' scale:='1 1 1'">
    <link name="${link_name}">
      <visual>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry>
          <mesh filename="${piper_mesh_dir}/${mesh_name}" scale="${scale}"/>
        </geometry>
        <material name="${material_name}"/>
      </visual>
    </link>
  </xacro:macro>

  <xacro:macro name="FixedJoint" params="name parent child xyz rpy">
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="VisualPiper" params="prefix mount_y">
    <xacro:PiperMeshLink link_name="${prefix}_base_link"
                         mesh_name="base_Link.dae" material_name="piper_gray"/>
    <xacro:FixedJoint name="${prefix}_mount_joint"
                      parent="base_link" child="${prefix}_base_link"
                      xyz="0 ${mount_y} 1.570" rpy="${pi} 0 ${pi}"/>

    <xacro:PiperMeshLink link_name="${prefix}_Link1"
                         mesh_name="J1.dae" material_name="piper_gray"/>
    <xacro:FixedJoint name="${prefix}_joint1_display"
                      parent="${prefix}_base_link" child="${prefix}_Link1"
                      xyz="0 0 0.123" rpy="0 0 0"/>

    <!-- Separate origin and angle links preserve origin * RotZ(q), including
         joint2's non-commuting roll/pitch mounting rotation. -->
    <link name="${prefix}_joint2_origin_link"/>
    <xacro:FixedJoint name="${prefix}_joint2_origin"
                      parent="${prefix}_Link1" child="${prefix}_joint2_origin_link"
                      xyz="0 0 0" rpy="1.5708 -0.13586 3.1416"/>
    <xacro:PiperMeshLink link_name="${prefix}_Link2"
                         mesh_name="J2.dae" material_name="piper_gray"/>
    <xacro:FixedJoint name="${prefix}_joint2_display"
                      parent="${prefix}_joint2_origin_link" child="${prefix}_Link2"
                      xyz="0 0 0" rpy="0 0 0.5"/>

    <link name="${prefix}_joint3_origin_link"/>
    <xacro:FixedJoint name="${prefix}_joint3_origin"
                      parent="${prefix}_Link2" child="${prefix}_joint3_origin_link"
                      xyz="0.28503 0 0" rpy="0 0 2.8377"/>
    <xacro:PiperMeshLink link_name="${prefix}_Link3"
                         mesh_name="J3.dae" material_name="piper_gray"/>
    <xacro:FixedJoint name="${prefix}_joint3_display"
                      parent="${prefix}_joint3_origin_link" child="${prefix}_Link3"
                      xyz="0 0 0" rpy="0 0 -1.8"/>

    <xacro:PiperMeshLink link_name="${prefix}_Link4"
                         mesh_name="J4.dae" material_name="piper_light_gray"/>
    <xacro:FixedJoint name="${prefix}_joint4_display"
                      parent="${prefix}_Link3" child="${prefix}_Link4"
                      xyz="0.27264 0 0" rpy="0 0 0.075129"/>

    <xacro:PiperMeshLink link_name="${prefix}_Link5"
                         mesh_name="J5.dae" material_name="piper_gray"/>
    <xacro:FixedJoint name="${prefix}_joint5_display"
                      parent="${prefix}_Link4" child="${prefix}_Link5"
                      xyz="0.076857 0.00062395 0" rpy="-1.5708 0 0"/>

    <xacro:PiperMeshLink link_name="${prefix}_Link6"
                         mesh_name="gripper_base_100_v2.dae"
                         material_name="piper_white"
                         xyz="0.002 0.0078 0.06" rpy="-1.57 0 3.14"
                         scale="0.8 0.8 0.8"/>
    <xacro:FixedJoint name="${prefix}_joint6_display"
                      parent="${prefix}_Link5" child="${prefix}_Link6"
                      xyz="0.035 0 0" rpy="1.5708 0 1.5708"/>

    <xacro:PiperMeshLink link_name="${prefix}_Link7"
                         mesh_name="J7.dae" material_name="piper_light_gray"/>
    <xacro:FixedJoint name="${prefix}_joint7_display"
                      parent="${prefix}_Link6" child="${prefix}_Link7"
                      xyz="0 0 0.13503" rpy="1.5708 0 1.5708"/>

    <xacro:PiperMeshLink link_name="${prefix}_Link8"
                         mesh_name="J8.dae" material_name="piper_finger_blue"/>
    <xacro:FixedJoint name="${prefix}_joint8_display"
                      parent="${prefix}_Link6" child="${prefix}_Link8"
                      xyz="0 0 0.13503" rpy="-1.5708 0 1.5708"/>
  </xacro:macro>

  <xacro:macro name="PayloadTower">
    <link name="payload_tower_visual_link">
      <visual>
        <origin xyz="0 0 1.050"/>
        <geometry><cylinder radius="0.025" length="1.100"/></geometry>
        <material name="payload_steel"/>
      </visual>
      <visual>
        <origin xyz="0 0 1.600"/>
        <geometry><box size="0.120 0.720 0.080"/></geometry>
        <material name="payload_steel"/>
      </visual>
      <visual>
        <origin xyz="0.050 0 1.520"/>
        <geometry><box size="0.100 0.040 0.040"/></geometry>
        <material name="payload_steel"/>
      </visual>
      <visual>
        <origin xyz="0 0.300 1.585"/>
        <geometry><box size="0.180 0.180 0.030"/></geometry>
        <material name="payload_steel"/>
      </visual>
      <visual>
        <origin xyz="0 -0.300 1.585"/>
        <geometry><box size="0.180 0.180 0.030"/></geometry>
        <material name="payload_steel"/>
      </visual>
    </link>
    <xacro:FixedJoint name="payload_tower_visual_joint"
                      parent="base_link" child="payload_tower_visual_link"
                      xyz="0 0 0" rpy="0 0 0"/>

    <!-- A visual-only frame avoids duplicating the live camera_link TF that
         Isaac's RGB-D publisher already provides. -->
    <link name="rgbd_camera_housing_visual_link">
      <visual>
        <origin xyz="-0.060 0 0"/>
        <geometry><box size="0.120 0.240 0.160"/></geometry>
        <material name="payload_camera_dark"/>
      </visual>
    </link>
    <xacro:FixedJoint name="rgbd_camera_housing_visual_joint"
                      parent="base_link" child="rgbd_camera_housing_visual_link"
                      xyz="0.100 0 1.520" rpy="0 ${radians(12)} 0"/>

    <xacro:VisualPiper prefix="left_piper" mount_y="0.300"/>
    <xacro:VisualPiper prefix="right_piper" mount_y="-0.300"/>
  </xacro:macro>
</robot>
