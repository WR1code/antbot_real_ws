<?xml version="1.0" ?>
<!--
  GK4XC-001-003 production chassis visual.

  The source STEP is authored in millimetres. The generated STL is centred
  around its source axes. In the supplied assembly CAD +X is the installed
  vertical direction, so a -90 degree ROS Y rotation puts the wheel platform
  on the floor with its column and manipulator above the chassis.
  Keep collision geometry simple: the detailed mesh is visual-only.
-->
<robot name="base" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="Base">
    <link name="base_link">
      <inertial>
        <origin xyz="0 0 0.225" rpy="0 0 0"/>
        <mass value="78.0"/>
        <inertia ixx="2.56" ixy="0" ixz="0" iyy="5.14" iyz="0" izz="6.37"/>
      </inertial>

      <visual>
        <origin xyz="0.2754 0 0.6430" rpy="0 -1.57079632679 0"/>
        <geometry>
          <mesh filename="package://antbot_description/meshes/gk4xc_001_003_full.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="gk4xc_metal">
          <color rgba="0.66 0.69 0.73 1.0"/>
        </material>
      </visual>

      <!-- Conservative envelope for planning; never use the CAD mesh itself
           as a real-time collision shape. -->
      <collision>
        <origin xyz="0 0 0.6430" rpy="0 0 0"/>
        <geometry><box size="0.5510 0.8186 1.2861"/></geometry>
      </collision>
    </link>
  </xacro:macro>
</robot>
