<?xml version="1.0" ?>
<!--
  Four independent steering + drive kinematic modules.
  Their visible hardware is already part of the all-in-one GK4XC STEP mesh, so
  these links intentionally contain collision and inertia only.
-->
<robot name="wheel" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="SwerveWheelLeft" params="position_name x_pos y_pos">
    <link name="${position_name}_steering_link">
      <collision><origin xyz="0 -0.020 0.035"/><geometry><box size="0.050 0.075 0.110"/></geometry></collision>
      <inertial><mass value="1.0"/><origin xyz="0 -0.020 0.035"/><inertia ixx="0.0017" ixy="0" ixz="0" iyy="0.0014" iyz="0" izz="0.0008"/></inertial>
    </link>
    <joint name="steering_${position_name}_joint" type="continuous">
      <parent link="base_link"/><child link="${position_name}_steering_link"/>
      <origin xyz="${x_pos} ${y_pos} ${steering_height}"/><axis xyz="0 0 1"/>
      <limit effort="1000" velocity="6.5"/><dynamics damping="0.1" friction="0.01"/>
    </joint>
    <link name="${position_name}_wheel_link">
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <inertial><mass value="2.0"/><inertia ixx="0.0038" ixy="0" ixz="0" iyy="0.0064" iyz="0" izz="0.0038"/></inertial>
    </link>
    <joint name="wheel_${position_name}_joint" type="continuous">
      <parent link="${position_name}_steering_link"/><child link="${position_name}_wheel_link"/>
      <origin xyz="0 ${wheel_offset} 0"/><axis xyz="0 1 0"/><limit effort="200" velocity="50"/><dynamics damping="0.05" friction="0.02"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="SwerveWheelRight" params="position_name x_pos y_pos">
    <link name="${position_name}_steering_link">
      <collision><origin xyz="0 0.020 0.035"/><geometry><box size="0.050 0.075 0.110"/></geometry></collision>
      <inertial><mass value="1.0"/><origin xyz="0 0.020 0.035"/><inertia ixx="0.0017" ixy="0" ixz="0" iyy="0.0014" iyz="0" izz="0.0008"/></inertial>
    </link>
    <joint name="steering_${position_name}_joint" type="continuous">
      <parent link="base_link"/><child link="${position_name}_steering_link"/>
      <origin xyz="${x_pos} ${y_pos} ${steering_height}"/><axis xyz="0 0 1"/>
      <limit effort="1000" velocity="6.5"/><dynamics damping="0.1" friction="0.01"/>
    </joint>
    <link name="${position_name}_wheel_link">
      <collision><origin rpy="${-pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <inertial><mass value="2.0"/><inertia ixx="0.0038" ixy="0" ixz="0" iyy="0.0064" iyz="0" izz="0.0038"/></inertial>
    </link>
    <joint name="wheel_${position_name}_joint" type="continuous">
      <parent link="${position_name}_steering_link"/><child link="${position_name}_wheel_link"/>
      <origin xyz="0 ${-wheel_offset} 0"/><axis xyz="0 1 0"/><limit effort="200" velocity="50"/><dynamics damping="0.05" friction="0.02"/>
    </joint>
  </xacro:macro>
</robot>
