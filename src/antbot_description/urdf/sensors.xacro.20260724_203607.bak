<?xml version="1.0" ?>
<!--
  Sensor frame macros for ANTBot.
  Provides fixed-joint sensor mounting utilities.
-->
<robot name="sensors" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="Sensors" params="name xyz rpy">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${name}_link"/>
  </xacro:macro>

  <xacro:macro name="SensorsRel" params="parent child xyz rpy">
    <joint name="${child}_joint" type="fixed">
      <parent link="${parent}_link"/>
      <child link="${child}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${child}_link"/>
  </xacro:macro>

  <xacro:macro name="OpticalFrame" params="name parent xyz:='0 0 0' rpy:='${radians(-90)} 0 ${radians(-90)}'">
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}_link"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${name}_link"/>
  </xacro:macro>

  <xacro:macro name="CalibratedSensors" params="name default_xyz default_rpy calibration_key">
    <!--
      Missing calibration entries and partially populated entries fall back
      independently.  The tx..rz form remains supported for existing files.
    -->
    <xacro:property name="calib_data"
                    value="${calibration_config.get(calibration_key, dict())}"/>
    <xacro:property name="calib_xyz" value="${
      calib_data.get('xyz',
        [calib_data['tx'], calib_data['ty'], calib_data['tz']]
        if 'tx' in calib_data and 'ty' in calib_data and 'tz' in calib_data
        else default_xyz)}"/>
    <xacro:property name="calib_rpy" value="${
      calib_data.get('rpy',
        [calib_data['rx'], calib_data['ry'], calib_data['rz']]
        if 'rx' in calib_data and 'ry' in calib_data and 'rz' in calib_data
        else default_rpy)}"/>
    <xacro:property name="calib_xyz_string"
                    value="${str(calib_xyz).strip('[]').replace(',', '')}"/>
    <xacro:property name="calib_rpy_string"
                    value="${str(calib_rpy).strip('[]').replace(',', '')}"/>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${calib_xyz_string}" rpy="${calib_rpy_string}"/>
    </joint>
    <link name="${name}_link"/>
  </xacro:macro>


  <!--
    Compact dome-style 360-degree lidar mounted on a white shoulder corner.
    The link/joint origin is the shoulder mounting plane.  The blue sphere is
    intentionally embedded into the black base so that only a dome is visible.
  -->
  <xacro:macro name="CalibratedTopLidar" params="name default_xyz default_rpy calibration_key">
    <xacro:property name="calib_data"
                    value="${calibration_config.get(calibration_key, dict())}"/>
    <xacro:property name="calib_xyz" value="${
      calib_data.get('xyz',
        [calib_data['tx'], calib_data['ty'], calib_data['tz']]
        if 'tx' in calib_data and 'ty' in calib_data and 'tz' in calib_data
        else default_xyz)}"/>
    <xacro:property name="calib_rpy" value="${
      calib_data.get('rpy',
        [calib_data['rx'], calib_data['ry'], calib_data['rz']]
        if 'rx' in calib_data and 'ry' in calib_data and 'rz' in calib_data
        else default_rpy)}"/>
    <xacro:property name="calib_xyz_string"
                    value="${str(calib_xyz).strip('[]').replace(',', '')}"/>
    <xacro:property name="calib_rpy_string"
                    value="${str(calib_rpy).strip('[]').replace(',', '')}"/>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${calib_xyz_string}" rpy="${calib_rpy_string}"/>
    </joint>

    <link name="${name}_link">
      <!-- low black mounting puck -->
      <visual>
        <origin xyz="0 0 0.005" rpy="0 0 0"/>
        <geometry><cylinder radius="0.026" length="0.009"/></geometry>
        <material name="lidar_base_black"><color rgba="0.025 0.030 0.035 1.0"/></material>
      </visual>
      <!-- blue/black optical dome, matching the supplied UMR photographs -->
      <visual>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry><sphere radius="0.023"/></geometry>
        <material name="lidar_dome_blue"><color rgba="0.035 0.33 0.82 1.0"/></material>
      </visual>
      <!-- dark lower mask hides the lower half of the sphere -->
      <visual>
        <origin xyz="0 0 0.007" rpy="0 0 0"/>
        <geometry><cylinder radius="0.025" length="0.014"/></geometry>
        <material name="lidar_lower_mask"><color rgba="0.035 0.040 0.045 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.018" rpy="0 0 0"/>
        <geometry><cylinder radius="0.027" length="0.036"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.018" rpy="0 0 0"/>
        <mass value="0.25"/>
        <inertia ixx="0.000036" ixy="0" ixz="0" iyy="0.000036" iyz="0" izz="0.000091"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Short black cylindrical unit on the opposite shoulder diagonal. -->
  <xacro:macro name="TopCornerCylinder" params="name xyz rpy">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0.009" rpy="0 0 0"/>
        <geometry><cylinder radius="0.018" length="0.018"/></geometry>
        <material name="corner_cylinder_black"><color rgba="0.035 0.040 0.045 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 0.019" rpy="0 0 0"/>
        <geometry><cylinder radius="0.015" length="0.002"/></geometry>
        <material name="corner_cylinder_cap"><color rgba="0.17 0.18 0.19 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.009" rpy="0 0 0"/>
        <geometry><cylinder radius="0.018" length="0.018"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.009" rpy="0 0 0"/>
        <mass value="0.06"/>
        <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000010"/>
      </inertial>
    </link>
  </xacro:macro>

</robot>
