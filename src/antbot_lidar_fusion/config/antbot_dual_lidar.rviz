Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 28; 28; 32
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 130; 130; 130
      Enabled: true
      Name: Grid
      Plane: XY
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /antbot/robot_description
      Enabled: true
      Name: RobotModel
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 0; 255; 255
      Decay Time: 0
      Enabled: true
      Name: Front-left raw scan
      Position Transformer: XYZ
      Size (Pixels): 4
      Style: Points
      Topic:
        Depth: 10
        Reliability Policy: Best Effort
        Value: /scan_0
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 40; 190
      Decay Time: 0
      Enabled: true
      Name: Rear-right raw scan
      Position Transformer: XYZ
      Size (Pixels): 4
      Style: Points
      Topic:
        Depth: 10
        Reliability Policy: Best Effort
        Value: /scan_1
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 230; 40
      Color Transformer: FlatColor
      Enabled: true
      Name: Combined filtered cloud
      Position Transformer: XYZ
      Size (Pixels): 5
      Size (m): 0.035
      Style: Points
      Topic:
        Depth: 10
        Reliability Policy: Best Effort
        Value: /antbot/lidar/combined_points
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.5
      Name: Base axes
      Radius: 0.025
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.75
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
