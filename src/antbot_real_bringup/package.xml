<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>antbot_real_bringup</name>
  <version>0.1.0</version>
  <description>Real-machine bringup for AntBot with the STM32H743 chassis.</description>
  <maintainer email="wr@example.invalid">WR</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>antbot_description</exec_depend>
  <exec_depend>antbot_h743_bridge</exec_depend>
  <exec_depend>antbot_navigation</exec_depend>
  <exec_depend>antbot_dual_lidar</exec_depend>
  <exec_depend>antbot_rgbd_dataset</exec_depend>
  <exec_depend>antbot_teleop</exec_depend>
  <exec_depend>joy_linux</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>robotcar_navigation</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
