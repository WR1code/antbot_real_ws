<?xml version="1.0"?>
<package format="3">
  <name>rebotarm_demo_rviz</name>
  <version>0.1.0</version>
  <description>Integrated RViz panel for reBotArm MoveIt planning, safety, teaching, and actions.</description>
  <maintainer email="devnull@example.com">workspace maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>action_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rebotarm_msgs</depend>
  <depend>rclcpp_action</depend>
  <depend>rebot_teach_msgs</depend>
  <depend>rviz_common</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>rebotarm_moveit_demos</exec_depend>
  <exec_depend>meridian_hand_vision</exec_depend>
  <exec_depend>moveit_calibration_gui</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>rebotarm_pulse</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/rebotarm_demo_rviz_plugin.xml"/>
  </export>
</package>
