<?xml version="1.0" encoding="utf-8"?>
<!--
  Piper-H six-axis model derived from AgileX Robotics agx_arm_urdf.
  Upstream: https://github.com/agilexrobotics/agx_arm_urdf
  Upstream commit: f6642ce0d7872c686f29c99e9e10cd23d1d49313

  The upstream lowercase link names are kept compatible with this workspace as
  Link1..Link6. Joint names and all kinematic/dynamic values are unchanged.
  The separate world link from upstream is intentionally supplied by the
  consuming MoveIt xacro so installations can choose their mounting transform.
-->
<robot name="piper_h_description">
  <link name="base_link">
    <inertial>
      <origin xyz="-0.00473641164191482 2.56829134630247E-05 0.041451518036016" rpy="0 0 0"/>
      <mass value="1.02"/>
      <inertia ixx="0.00267433" ixy="-0.00000073" ixz="-0.00017389"
               iyy="0.00282612" iyz="0.0000004" izz="0.00089624"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://piper_h_description/meshes/dae/base_link.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://piper_h_description/meshes/base_link.STL"/></geometry></collision>
  </link>

