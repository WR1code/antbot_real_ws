  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 0"/><parent link="base_link"/><child link="Link1"/><axis xyz="0 0 1"/>
    <limit lower="-2.6179938" upper="2.6179938" effort="100" velocity="5"/>
  </joint>

