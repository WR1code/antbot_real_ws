Panels:
  - Class: rebotarm_demo_rviz/DualArmSelectorPanel
    Name: 双臂统一工作台
  - Class: rebotarm_demo_rviz/DemoPanel
    Name: 机械臂控制
  - Class: piperh_motion_rviz/MotionPresetPanel
    Name: 双臂预设动作
  - Class: robotcar_navigation/VehicleStatusPanel
    Name: 车辆控制中心
  - Class: robotcar_navigation/WaypointManagerPanel
    Name: 航点与巡航组
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: 地面
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: 整机 TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /antbot/robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: ANTBot 底盘整机模型
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rebotarm/robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: reBotArm 实机模型
      TF Prefix: rebotarm
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Enabled: true
      Move Group Namespace: /rebotarm
      Name: 当前机械臂运动规划
      Planned Path:
        Color Enabled: true
        Interrupt Display: true
        Loop Animation: false
        Robot Alpha: 0.65
        Robot Color: 40; 130; 210
        Show Robot Collision: false
        Show Robot Visual: true
        Show Trail: false
        State Display Time: 1x
      Planning Request:
        Goal State Alpha: 0.65
        Goal State Color: 245; 145; 35
        Planning Group: arm
        Query Goal State: true
        Query Start State: false
      Robot Description: robot_description
      Scene Robot:
        Robot Alpha: 0
        Show Robot Collision: false
        Show Robot Visual: false
      Value: true
    - Attached Body Color: 150; 50; 150
      Class: moveit_rviz_plugin/RobotState
      Collision Enabled: false
      Enabled: false
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: reBotArm 动作组动画
      Robot Alpha: 1
      Robot Description: robot_description
      Robot State Topic: /rebotarm/display_robot_state
      Show All Links: true
      Show Highlights: true
      Value: false
      Visual Enabled: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /piperh/robot_description
      Enabled: false
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: Piper-H 实机模型
      TF Prefix: piperh
      Update Interval: 0
      Value: false
      Visual Enabled: true
    - Alpha: 0.8
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: 底盘地图
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
      Use Timestamp: false
      Value: true
    - Alpha: 0.8
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: RViz 实时建图
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /antbot/mapping/map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /antbot/mapping/map_updates
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 20
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: MID360 FAST-LIO 实时点云
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cloud_registered
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: 底盘全局路径
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 80; 80
      Color Transformer: FlatColor
      Enabled: true
      Name: 前雷达
      Position Transformer: XYZ
      Size (Pixels): 3
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan_0
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 80; 180; 255
      Color Transformer: FlatColor
      Enabled: true
      Name: 后雷达
      Position Transformer: XYZ
      Size (Pixels): 3
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan_1
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.42
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Enabled: true
      Name: Step1 离线三维点云
      Position Transformer: XYZ
      Size (Pixels): 1
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /antbot/offline_map_points
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.35
      Class: rviz_default_plugins/PointCloud2
      Color: 80; 180; 255
      Color Transformer: FlatColor
      Enabled: true
      Name: 当前累积三维点云
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /antbot/lidar/map_points
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: true
      Name: Step1 RGB-D 彩色点云
      Position Transformer: XYZ
      Size (Pixels): 4
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /antbot/rgbd/offline_cloud
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/InteractiveMarkers
      Enabled: true
      Interactive Markers Namespace: /waypoints_move
      Name: 航点交互标记
      Show Axes: false
      Show Descriptions: true
      Show Visual Aids: false
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: 航点名称
      Topic:
        Depth: 100
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /text_marker
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Piper-H 把脉末端（待标定）
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /piperh/pulse/tool_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Piper-H 两阶段预接触路径
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /piperh/pulse/staged_precontact_markers
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Piper-H 视觉腕点
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /piperh/pulse/target_marker
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 命名禁行区
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /waterplus/keepout_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 命名限速区
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /waterplus/speed_zone_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 安全范围与脱困历史
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /antbot/awareness_markers
      Value: true
    - Alpha: 0.35
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: 全局代价地图
      Topic:
        Value: /global_costmap/costmap
      Update Topic:
        Value: /global_costmap/costmap_updates
      Value: true
    - Alpha: 0.5
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: 局部代价地图
      Topic:
        Value: /local_costmap/costmap
      Update Topic:
        Value: /local_costmap/costmap_updates
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 50
      Name: 底盘里程计
      Topic:
        Value: /odometry/filtered
      Value: true
    - Alpha: 0.95
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 60; 20
      Color Transformer: FlatColor
      Enabled: true
      Name: 雷达新障碍物
      Position Transformer: XYZ
      Size (Pixels): 5
      Style: Flat Squares
      Topic:
        Value: /antbot/dynamic_obstacles/lidar_points
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.95
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: true
      Name: 视觉新障碍物
      Position Transformer: XYZ
      Size (Pixels): 5
      Style: Flat Squares
      Topic:
        Value: /antbot/dynamic_obstacles/visual_points
      Use Fixed Frame: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: robotcar_navigation/AddWaypoint
      Topic: /waterplus/add_waypoint
      Waypoint Name: ""
    - Charger Name: ""
      Class: robotcar_navigation/AddCharger
      Topic: /waterplus/add_charger
    - Class: robotcar_navigation/AddKeepoutZone
      Topic: /waterplus/add_keepout
      Zone Name: 临时禁区
      当前宽度 X (m): 1
      当前高度 Y (m): 1
      形状: 矩形
    - Class: robotcar_navigation/AddSpeedZone
      Max Speed (m/s): 0.3
      Topic: /waterplus/add_speed_zone
      Zone Name: 低速区
      当前宽度 X (m): 2
      当前高度 Y (m): 2
      形状: 矩形
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.2
      Focal Point:
        X: 0
        Y: 0
        Z: 0.75
      Name: Current View
      Pitch: 0.55
      Target Frame: odom
      Value: Orbit (rviz)
      Yaw: 5.5
    Saved: ~
Window Geometry:
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1440
  X: 80
  Y: 60
  机械臂选择:
    collapsed: false
