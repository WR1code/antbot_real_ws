<?xml version="1.0"?>
<package format="3">
  <name>piperh_motion_rviz</name>
  <version>0.1.0</version>
  <description>RViz panel for Piper-H motion presets, ordered groups, and execution progress.</description>
  <maintainer email="devnull@example.com">workspace maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>moveit_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rebotarm_msgs</depend>
  <depend>rviz_common</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/piperh_motion_rviz_plugin.xml"/>
  </export>
</package>
